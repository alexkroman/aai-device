CONFIG_IDF_TARGET="esp32s3"

# Board: ESP32-S3 (QFN56) with 16 MB flash + 8 MB octal PSRAM, console over native USB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Lets EXT_RAM_BSS_ATTR move big zero-initialized buffers out of internal RAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_FREERTOS_HZ=1000

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP-SR: wake word only (no on-device command recognition). Swap this line to change it,
# e.g. CONFIG_SR_WN_WN10_ALEXA=y or CONFIG_SR_WN_WN9_JARVIS_TTS=y (then delete sdkconfig).
CONFIG_SR_WN_WN9_COMPUTER_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# The AFE keeps both cores busy; don't let the idle-task watchdog reboot us
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Mic frames (sender task) and control messages must not wait on the receive path's lock
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
