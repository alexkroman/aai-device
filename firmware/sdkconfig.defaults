CONFIG_IDF_TARGET="esp32s3"

# Board: ESP32-S3 (QFN56) with 16 MB flash + 8 MB octal PSRAM, console over native USB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Lets EXT_RAM_BSS_ATTR move big zero-initialized buffers out of internal RAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_FREERTOS_HZ=1000
# -O2: the default (-Og, debug) slows everything built from source here — lwIP, the websocket
# client, mbedTLS, drivers, FreeRTOS. ESP-SR ships prebuilt, so the AFE is unaffected.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Per-core load in the "playback ended" log (agent.c). Costs one timer read per context switch.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP-SR: wake word only (no on-device command recognition). Swap this line to change it,
# e.g. CONFIG_SR_WN_WN10_ALEXA=y or CONFIG_SR_WN_WN9_JARVIS_TTS=y (then delete sdkconfig).
CONFIG_SR_WN_WN9_COMPUTER_TTS=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# The AFE keeps both cores busy; don't let the idle-task watchdog reboot us
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Mic frames (sender task) and control messages must not wait on the receive path's lock
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y

# TCP receive window: the default 5.7 KB caps a 60 ms-RTT cloud agent at ~95 KB/s, only 2x the
# 48 KB/s of 24 kHz TTS, so the playback buffer refills slowly after a Wi-Fi stall. The
# mailbox holds a window's worth of segments. Buffers go to PSRAM (SPIRAM_TRY_ALLOCATE_WIFI_LWIP).
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32

# Over-the-air updates (ota.c): an image that resets before ota_mark_healthy() is rolled
# back. Plain http:// is allowed so `make ota-serve` works on the LAN without certificates.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# A crash saves a core dump to the `coredump` partition (crash.c logs it at the next boot).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# mDNS (discovery.c): its task and allocations in PSRAM, like the rest of the network-only
# work, so it costs none of the internal RAM the websocket clients need.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
