#!/usr/bin/env bash
# Formats the staged files with each language's formatter (make format-files) and re-stages
# them. Installed by `make hooks` (and `make check`): git config core.hooksPath .githooks.
#
# A file with unstaged changes too is formatted in neither place and named instead: the
# formatter rewrites the working tree, so re-staging it would commit the unstaged hunks
# with it. `make format` (or staging the whole file) catches it up.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

files=()
partial=()
while IFS= read -r -d '' f; do
  if git diff --quiet -- "$f"; then files+=("$f"); else partial+=("$f"); fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

for f in ${partial[@]+"${partial[@]}"}; do
  echo "pre-commit: not formatting $f (partly staged); run make format" >&2
done
[ ${#files[@]} -eq 0 ] && exit 0

make -s format-files FILES="${files[*]}"
git add -- "${files[@]}"
